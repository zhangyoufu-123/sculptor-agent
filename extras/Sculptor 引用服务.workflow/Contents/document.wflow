<dict>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>AMAcceptsInput</key>
				<true/>
				<key>AMActionVersion</key>
				<string>2.0.3</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict/>
				<key>actionName</key>
				<string>Run Shell Script</string>
				<key>actionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
SEL="$(cat)"
SCULPTOR_BIN="${SCULPTOR_BIN:-$HOME/.local/bin/sculptor}"
PROJECT="${SCULPTOR_PROJECT:-$HOME/Documents}"
INSTRUCTION="$(osascript -e 'set T to text returned of (display dialog "修改指令（例如：这句太文艺，收一点）" default answer "帮我改一下" with title "Sculptor")' 2>/dev/null)"
if [ -x "$SCULPTOR_BIN" ]; then
  "$SCULPTOR_BIN" point-edit "$SEL" "$INSTRUCTION" --dir "$PROJECT"
else
  printf '〔Sculptor 引用〕《%s》\n修改指令：%s' "$SEL" "$INSTRUCTION" | pbcopy
  osascript -e 'display notification "引用已复制到剪贴板" with title "Sculptor"'
fi</string>
					<key>checkedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string>#!/bin/bash
SEL="$(cat)"
SCULPTOR_BIN="${SCULPTOR_BIN:-$HOME/.local/bin/sculptor}"
PROJECT="${SCULPTOR_PROJECT:-$HOME/Documents}"
INSTRUCTION="$(osascript -e 'set T to text returned of (display dialog "修改指令（例如：这句太文艺，收一点）" default answer "帮我改一下" with title "Sculptor")' 2>/dev/null)"
if [ -x "$SCULPTOR_BIN" ]; then
  "$SCULPTOR_BIN" point-edit "$SEL" "$INSTRUCTION" --dir "$PROJECT"
else
  printf '〔Sculptor 引用〕《%s》\n修改指令：%s' "$SEL" "$INSTRUCTION" | pbcopy
  osascript -e 'display notification "引用已复制到剪贴板" with title "Sculptor"'
fi</string>
				</dict>
